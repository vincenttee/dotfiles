[core]
    pager = delta
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main

[http "https://gopkg.in"]
    followRedirects = true

[interactive]
    diffFilter = delta --color-only
    singlekey = true

[delta]
    navigate = true
    line-numbers = true
    side-by-side = false
    syntax-theme = gruvbox-dark

[branch]
    sort = -committerdate

[fetch]
    prune = true

[pull]
    rebase = true

[merge]
    conflictStyle = zdiff3

[rerere]
    enabled = true

[pretty]
    graph = format:%C(red)%h%C(reset) -%C(yellow)%d%C(reset) %s %C(green)(%cr) %C(bold blue)<%an>%C(reset)

[alias]
    aliases = "!git config --get-regexp '^alias[.]' | awk '$1 != \"alias.aliases\" { k = substr($1, 7); sub(/^[^ ]+ /, \"\"); printf \"\\033[1;33m%-14s\\033[0m \\033[2m=\\033[0m %s\\n\", k, $0 }'"

    amend        = commit --amend
    amend-noedit = commit --amend --no-edit
    wip          = !git add -A && git commit --no-verify -m WIP
    unwip        = !git log -1 --format=%s | grep -qx WIP && git reset HEAD^ || echo 'last commit is not WIP'
    extract      = !git reset -p HEAD^ && git commit --amend --no-edit

    unstage   = restore --staged
    stash-all = stash push --include-untracked

    pushf = push --force-with-lease

    last        = log -1 -p --stat -U5
    log-oneline = log --oneline --all --decorate
    log-graph   = log --graph --all --decorate --pretty=graph
    log-authors = shortlog -sn --no-merges HEAD
