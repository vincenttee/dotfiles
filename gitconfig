[core]
    pager = delta
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main

[http "https://gopkg.in"]
    followRedirects = true

[interactive]
    diffFilter = delta --color-only
    singlekey = true

[delta]
    navigate = true
    line-numbers = true
    side-by-side = false
    syntax-theme = gruvbox-dark

[branch]
    sort = -committerdate

[fetch]
    prune = true

[pull]
    rebase = true

[merge]
    conflictStyle = zdiff3

[rerere]
    enabled = true

[pretty]
    graph = format:%C(red)%h%C(reset) -%C(yellow)%d%C(reset) %s %C(green)(%cr) %C(bold blue)<%an>%C(reset)

[alias]
    aliases = "!git config --get-regexp '^alias(-help)?[.]' | awk '{ k = $1; sub(/^[^ ]+ /, \"\"); if (k ~ /^alias-help[.]/) h[substr(k, 12)] = $0; else if (k != \"alias.aliases\") { n++; key[n] = substr(k, 7); body[n] = $0 } } END { for (i = 1; i <= n; i++) { a = key[i]; if (a in h) printf \"\\033[1;33m%-12s\\033[0m \\033[2m#\\033[0m %s\\n\", a, h[a]; else printf \"\\033[1;33m%-12s\\033[0m \\033[2m=\\033[0m %s\\n\", a, body[i] } }'"

    amend        = commit --amend
    amend-noedit = commit --amend --no-edit
    wip          = !git add -A && git commit --no-verify -m WIP
    unwip        = !git log -1 --format=%s | grep -qx WIP && git reset HEAD^ || echo 'last commit is not WIP'
    extract      = !git reset -p HEAD^ && git commit --amend --no-edit

    unstage   = restore --staged
    stash-all = stash push --include-untracked

    pushf = push --force-with-lease

    last        = show --stat -p -U5
    log-oneline = log --oneline --all --decorate
    log-graph   = log --graph --all --decorate --pretty=graph
    log-week    = "!git log --pretty=graph --all --no-merges --since='1 week ago' --author=\"$(git config user.email)\""

    default  = "!f() { git symbolic-ref -q --short refs/remotes/origin/HEAD || { git show-ref -q --verify refs/remotes/origin/main && echo origin/main; } || echo origin/master; }; f"
    log-main = "!git log --pretty=graph --first-parent $(git default)"
    log-prs  = "!git log-main --perl-regexp --author='^((?!\\[bot\\]).)*$' --grep='dependabot/' --invert-grep"
    log-new  = "!git log --pretty=graph --no-merges $(git default)..HEAD"

    log-find = log --pretty=graph -S
    log-file = log --follow -p --stat
    log-func = "!f() { cd -- \"${GIT_PREFIX:-.}\" && git log -L \":$1:$2\"; }; f"

    log-hot     = "!f() { cd -- \"${GIT_PREFIX:-.}\" && git log --format= --name-only --no-merges \"$@\" | grep -v '^$' | sort | uniq -c | sort -rn | head -20; }; f"
    log-buggy   = "!f() { cd -- \"${GIT_PREFIX:-.}\" && git log-fixes --format= --name-only \"$@\" | grep -v '^$' | sort | uniq -c | sort -rn | head -20; }; f"
    log-fixes   = log --pretty=graph --no-merges -i -E --grep='fix|bug|revert|hotfix'
    log-coupled = "!f() { cd -- \"${GIT_PREFIX:-.}\" && p=$(git ls-files --full-name -- \"$1\") && h=$(git log --format=%H --no-merges -- \"$1\") && [ -n \"$h\" ] && git show --format= --name-only $h | grep -vx -e '' -e \"${p:-$1}\" | sort | uniq -c | sort -rn | head -20; }; f"
    log-owners  = "!f() { cd -- \"${GIT_PREFIX:-.}\" && git blame -w -M -C --line-porcelain -- \"$1\" | sed -n 's/^author //p' | sort | uniq -c | sort -rn; }; f"
    log-authors = shortlog -sn --no-merges HEAD

[alias-help]
    default     = "default branch ref (origin/main or origin/master)"
    log-oneline = "one line per commit, all refs"
    log-graph   = "commit graph, all refs"
    log-week    = "my commits from the last week, all refs"
    log-main    = "first-parent history of the default branch"
    log-prs     = "log-main without bot/dependabot commits"
    log-new     = "commits on HEAD not yet on the default branch"
    log-find    = "<string>  commits that add or remove <string>"
    log-file    = "<file>  patch history of a file, following renames"
    log-func    = "<function> <file>  history of one function"
    log-hot     = "[<log args>] [-- <path>]  most-changed files"
    log-buggy   = "[<log args>] [-- <path>]  files most touched by fix commits"
    log-fixes   = "[-p] [-- <file>]  commits matching fix|bug|revert|hotfix"
    log-coupled = "<file>  files most often changed in the same commits"
    log-owners  = "<file>  surviving lines per author (ignores whitespace/moves)"
    log-authors = "commit count per author on HEAD"
